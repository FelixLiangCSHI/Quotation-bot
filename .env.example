# Azure OpenAI configuration template (Phase 0 / subphase 02)
# Copy this file to .env and fill in the values provided by IT / AI platform.
# .env is gitignored - never commit real endpoints, keys, or deployment names.

# Azure OpenAI resource endpoint, e.g. https://<resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=

# Chat-completion deployment name provided by IT
AZURE_OPENAI_DEPLOYMENT=

# API version approved by IT, e.g. 2024-06-01
AZURE_OPENAI_API_VERSION=

# API key (only if Entra ID / managed identity is not available).
# Leave empty when using DefaultAzureCredential.
AZURE_OPENAI_API_KEY=

# --- Phase 2 reasoning layer (DeepSeek-v4-pro enterprise API slot) ---
# OpenAI-compatible base URL provided by the enterprise AI platform,
# e.g. https://ai-gateway.example.com/v1
LLM_API_BASE=

# Enterprise API key. The reasoning layer stays disabled until both
# LLM_API_BASE and LLM_API_KEY are set.
LLM_API_KEY=

# Model / deployment name (default: deepseek-v4-pro)
LLM_MODEL=deepseek-v4-pro

# Request timeout in seconds (default: 15)
LLM_TIMEOUT_SECONDS=15
